# HubSoft API credentials — copy to .env and fill in real values
# NEVER commit .env to version control

HUBSOFT_HOST=https://seu-provedor.hubsoft.com.br
HUBSOFT_CLIENT_ID=3
HUBSOFT_CLIENT_SECRET=seu-client-secret
HUBSOFT_USERNAME=usuario@provedor.com.br
HUBSOFT_PASSWORD=sua-senha

# Grant type (geralmente sempre "password")
HUBSOFT_GRANT_TYPE=password
HUBSOFT_ACCESS_TOKEN=eyJ0eXAiOiJ...

# Test data — use values that exist in your HubSoft tenant
TEST_CPF_CNPJ=12345678901
TEST_CODIGO_CLIENTE=421
TEST_ID_CLIENTE_SERVICO=22703
# 13	CLIENTE OFF - 12	MAN. INTERNET - 4	TÉCNICO - 40	SAC - 26	COBRANÇA
TEST_ID_TIPO_ATENDIMENTO=13
TEST_CEP=35560000
